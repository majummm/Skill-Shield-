# Copie este arquivo para ".env" e preencha com seus valores.
# NUNCA suba o arquivo ".env" (com os valores reais) para um repositorio publico.

# Chave de API do Google Gemini — crie gratuitamente em https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Modelo do Gemini a usar (opcional; padrao: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Chave secreta usada para assinar os cookies de sessao (login).
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Porta em que o servidor Flask vai rodar (opcional; padrao: 5000)
PORT=5000
